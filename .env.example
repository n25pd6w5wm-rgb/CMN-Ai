# cmn-ai local bootstrap credentials. Copy to ".env" and fill in.
# The .env file is gitignored — never commit real keys.
#
# EASY PATH: run  `uv run cmn-ai setup`  — it writes this file, checks/creates the
# api_keys table, and uploads your model keys interactively. The notes below are the
# manual equivalent.
#
# Only the Supabase project URL + service key live here. The actual model API
# keys (Anthropic, OpenAI, …) are stored IN Supabase and loaded at startup.
#
# Create the table in Supabase (SQL editor):
#
#   create table if not exists api_keys (
#     name  text primary key,
#     value text not null
#   );
#   -- keep it private; the service key (used here) bypasses RLS.
#   alter table api_keys enable row level security;
#
# Then insert your keys, using the env-var name as "name":
#
#   insert into api_keys (name, value) values
#     ('ANTHROPIC_API_KEY',  'sk-ant-...'),
#     ('OPENAI_API_KEY',     'sk-...'),
#     ('GEMINI_API_KEY',     '...'),
#     ('PERPLEXITY_API_KEY', 'pplx-...');

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_KEY=YOUR-SERVICE-ROLE-KEY

# Optional overrides:
# CMN_AI_PROFILE=mac
